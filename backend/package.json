{
  "name": "cloudops-monitor-backend",
  "version": "0.1.0",
  "private": true,
  "description": "HTTP API and background worker for CloudOps Monitor",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "dev:worker": "node --watch src/workers/worker.js",
    "start": "node src/server.js",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "pino-pretty": "^13.2.0",
    "prettier": "3.9.9"
  },
  "dependencies": {
    "bullmq": "^6.3.12",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "mongoose": "^9.11.1",
    "pino": "^10.4.0",
    "zod": "^4.6.5"
  }
}
