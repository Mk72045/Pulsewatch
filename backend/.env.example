NODE_ENV=development
PORT=5000
MONGO_URI=
CLIENT_URL=http://localhost:5173
JWT_SECRET=
JWT_EXPIRES_DAYS=7
RATE_LIMIT_TIME=15
MAX_MONITORS_PER_USER=10
CHECK_TIMEOUT_MS=10000
SCHEDULER_TICK_SECONDS=15
TRUST_PROXY=0
ALERT_TIME_ZONE=Asia/Kolkata

# Email alerts through Brevo. Leave empty to run without email.
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Pulsewatch

# Telegram alerts. Leave empty to run without Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Google sign-in. The OAuth Web client id from Google Cloud Console.
# Leave empty to run without Google sign-in (the buttons are hidden).
GOOGLE_CLIENT_ID=
